
@rendermode InteractiveServer

<nav class="site-nav">
    <div class="site-nav__inner">
        <a href="/" class="site-nav__brand">
            <img src="images/brand/logo.svg" alt="The Butcher's Mermaid" class="site-nav__logo" />
            <span class="site-nav__wordmark">
                <span class="site-nav__wordmark-the">The</span>
                <span class="site-nav__wordmark-name">Butcher's Mermaid</span>
            </span>
        </a>

        <button class="site-nav__toggle" @onclick="ToggleMobile" aria-label="Toggle navigation" aria-expanded="@_mobileOpen">
            <span class="site-nav__toggle-bar @(_mobileOpen ? "is-open-top" : "")"></span>
            <span class="site-nav__toggle-bar @(_mobileOpen ? "is-hidden" : "")"></span>
            <span class="site-nav__toggle-bar @(_mobileOpen ? "is-open-bottom" : "")"></span>
        </button>

        <div class="site-nav__links @(_mobileOpen ? "is-open" : "")">
            @foreach (var link in NavLinks)
            {
                <NavLink class="site-nav__link" href="@link.Href" Match="@link.Match">
                    @link.Label
                </NavLink>
            }
            <a href="https://www.dineplan.com/restaurant/the-butchers-mermaid"
               target="_blank"
               rel="noopener noreferrer"
               class="site-nav__cta">
                Reserve a Table
            </a>
        </div>
    </div>
</nav>

@code {
    private bool _mobileOpen;

    private void ToggleMobile() => _mobileOpen = !_mobileOpen;

    private record NavItem(string Label, string Href, NavLinkMatch Match);

    private static readonly NavItem[] NavLinks =
    {
        new("The Butchery", "/butchery",   NavLinkMatch.Prefix),
        new("Restaurant",   "/restaurant", NavLinkMatch.Prefix),
        new("Deli & Bar",   "/deli",       NavLinkMatch.Prefix),
        new("From the Sea", "/sea",        NavLinkMatch.Prefix),
        new("Menu",         "/menu",       NavLinkMatch.Prefix),
        new("Find Us",      "/contact",    NavLinkMatch.Prefix),
    };
}