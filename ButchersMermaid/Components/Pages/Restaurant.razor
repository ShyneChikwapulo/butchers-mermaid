
@page "/restaurant"
@rendermode InteractiveServer

<PageTitle>Restaurant — The Butcher's Mermaid</PageTitle>
<SeoMeta Title="Restaurant — The Butcher's Mermaid"
         Description="Steaks on hot stone, kudu fillet, hand-made burgers and charcuterie boards — served indoors or on the open terrace in Hout Bay."
         Image="images/business/restaurant-hero.jpg" />

<PageHero BackgroundImage="images/business/restaurant-hero.jpg"
          Eyebrow="The Restaurant"
          Title="Dine With Intention"
          Subtitle="Steaks on hot stone, kudu fillet, hand-made burgers and charcuterie boards — served indoors or on the open terrace." />

<section class="section">
    <div class="container">
        <div class="split-section">
            <div class="split-section__media">
                <img src="images/business/restaurant-food-1.jpg" alt="Plated dish at The Butcher's Mermaid restaurant" loading="lazy" />
            </div>
            <div class="split-section__body">
                <p class="eyebrow">From Our Kitchen</p>
                <h2>Every Plate, a Considered Experience</h2>
                <GoldDivider />
                <p>
                    Our kitchen works hand-in-hand with the butchery counter — the same
                    cuts you can buy to take home are the ones on your plate. That
                    connection is what makes dining here different: you're eating from
                    the same source of truth.
                </p>
                <p>
                    Signature steaks arrive on hot stone. Kudu fillet is dressed in a
                    Bordelaise sauce. Burgers are ground daily. Charcuterie boards are
                    assembled from our own curing room.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="section section-card">
    <div class="container">
        <div class="section-header">
            <p class="eyebrow">The Room</p>
            <h2 class="section-header__title">Inside or on the Terrace</h2>
            <GoldDivider />
        </div>

        <div class="photo-grid photo-grid--two">
            <img src="images/business/restaurant-food-2.jpg" alt="Signature dish at The Butcher's Mermaid" loading="lazy" />
            <img src="images/business/restaurant-terrace.jpg" alt="Outdoor terrace at The Butcher's Mermaid" loading="lazy" />
        </div>
    </div>
</section>

<section class="section">
    <div class="container container-narrow">
        <div class="section-header">
            <p class="eyebrow">Reservations</p>
            <h2 class="section-header__title">Book Your Table</h2>
            <GoldDivider />
            <p class="section-header__subtitle">
                Tables fill quickly on weekends. Booking is handled through Dineplan —
                secure, immediate, and cancellable. Walk-ins are welcome when we have
                space.
            </p>
            <div style="margin-top: var(--sp-8); display: flex; gap: var(--sp-4); justify-content: center; flex-wrap: wrap;">
                <a href="https://www.dineplan.com/restaurant/the-butchers-mermaid"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-primary">Book via Dineplan</a>
                <a href="/menu" class="btn btn-outline">View Menu</a>
            </div>
        </div>
    </div>
</section>