
@page "/butchery"
@rendermode InteractiveServer

<PageTitle>The Butchery — The Butcher's Mermaid</PageTitle>

<PageHero BackgroundImage="images/business/butchery-hero.jpg"
          Eyebrow="The Butchery"
          Title="Meat of the Highest Provenance"
          Subtitle="Wagyu, dry-aged beef, free-range lamb and pork — sourced with integrity, cut with craft." />

<section class="section">
    <div class="container">
        <div class="split-section">
            <div class="split-section__media">
                <img src="images/business/butchery-cuts.jpg" alt="Premium raw cuts at The Butcher's Mermaid" loading="lazy" />
            </div>
            <div class="split-section__body">
                <p class="eyebrow">From Paddock to Counter</p>
                <h2>The Craft of the Cut</h2>
                <GoldDivider />
                <p>
                    Our butchery counter is the heart of The Butcher's Mermaid. Every
                    primal, every cut, every trim is handled by dedicated blockmen who
                    know the difference between a good piece of meat and a great one —
                    and only ever sell the latter.
                </p>
                <p>
                    We work directly with pasture-reared, free-range producers. No
                    shortcuts, no compromise on provenance. The result is meat that
                    carries the character of where it came from.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="section section-card">
    <div class="container">
        <div class="section-header">
            <p class="eyebrow">What We Offer</p>
            <h2 class="section-header__title">The Range</h2>
            <GoldDivider />
        </div>

        <div class="photo-grid">
            <img src="images/business/butchery-charcuterie.jpg" alt="House-made charcuterie at The Butcher's Mermaid" loading="lazy" />
            <img src="images/business/butchery-counter.jpg" alt="The Butcher's Mermaid butchery counter" loading="lazy" />
            <img src="images/business/butchery-cuts.jpg" alt="Premium cuts at The Butcher's Mermaid" loading="lazy" />
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="split-section split-section--reverse">
            <div class="split-section__media">
                <img src="images/business/butchery-charcuterie.jpg" alt="Cured meats at The Butcher's Mermaid" loading="lazy" />
            </div>
            <div class="split-section__body">
                <p class="eyebrow">House-Made</p>
                <h2>Charcuterie &amp; Curing</h2>
                <GoldDivider />
                <p>
                    Coppa, bresaola, house biltong, and daily-changing seasonal
                    specialties — cured, aged, and prepared in-house. Our charcuterie
                    programme is the quiet pride of the butchery: patient, traditional,
                    and unrepeatable in a factory.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="section section-card">
    <div class="container container-narrow">
        <div class="section-header">
            <p class="eyebrow">Wholesale</p>
            <h2 class="section-header__title">Trusted by Kitchens Across Hout Bay</h2>
            <GoldDivider />
            <p class="section-header__subtitle">
                We supply premium meat to select restaurants in and around Hout Bay.
                If you run a kitchen and care about provenance, we should talk.
            </p>
            <div style="margin-top: var(--sp-8);">
                <a href="/wholesale" class="btn btn-outline">Wholesale Enquiries</a>
            </div>
        </div>
    </div>
</section>