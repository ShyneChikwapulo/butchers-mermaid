@page "/menu"
@rendermode InteractiveServer
@inject IMenuRepository MenuRepo
@using ButchersMermaid.Data.Entities


<PageTitle>Menu — The Butcher's Mermaid</PageTitle>
<SeoMeta Title="Menu — The Butcher's Mermaid"
         Description="Our full menu: steaks, burgers, seafood, charcuterie, salads, and sides. Sourced from our in-house butchery and served in Hout Bay."
         Image="images/business/restaurant-food-1.jpg" />

<PageHero BackgroundImage="images/business/restaurant-hero.jpg"
          Eyebrow="Our Menu"
          Title="From Butcher to Table"
          Subtitle="Every cut sourced from our in-house butchery, every plate prepared with intent." />

<section class="menu section">
    <div class="container">
        @if (_loading)
        {
            <p class="menu__loading">Loading menu…</p>
        }
        else if (_groups.Count == 0)
        {
            <p class="menu__empty">Menu is currently unavailable.</p>
        }
        else
        {
            @foreach (var group in _groups)
            {
                <div class="menu__group">
                    <header class="menu__group-header">
                        <h2 class="menu__group-title">@group.Key</h2>
                        <GoldDivider />
                    </header>

                    @foreach (var category in group)
                    {
                        <div class="menu__category">
                            <h3 class="menu__category-title">@category.Name</h3>

                            <ul class="menu__items">
                                @foreach (var item in category.Items)
                                {
                                    <li class="menu__item">
                                        <div class="menu__item-row">
                                            <span class="menu__item-name">@item.Name</span>
                                            <span class="menu__item-leader" aria-hidden="true"></span>
                                            <span class="menu__item-price">@FormatPrice(item)</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <p class="menu__item-desc">@item.Description</p>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            }
        }
    </div>
</section>

@code {
    private bool _loading = true;
    private List<IGrouping<string, MenuCategory>> _groups = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _groups = await MenuRepo.GetGroupedMenuAsync();
        _loading = false;
    }

    private static string FormatPrice(MenuItem item)
    {
        if (item.Prices.Count > 0)
        {
            // Multiple variants, e.g. "200g R230 · 300g R285 · 500g R355"
            var parts = item.Prices
                .OrderBy(p => p.SortOrder)
                .Select(p => string.IsNullOrWhiteSpace(p.PortionLabel)
                    ? $"R {p.Amount:0}"
                    : $"{p.PortionLabel} · R {p.Amount:0}");
            return string.Join("   ", parts);
        }

        if (item.BasePrice.HasValue)
        {
            return $"R {item.BasePrice.Value:0}";
        }

        // No price — show the note (e.g. "Market price") or a fallback dash
        return item.PriceNote ?? "—";
    }
}