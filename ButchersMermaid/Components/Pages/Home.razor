@page "/"
@rendermode InteractiveServer

<PageTitle>The Butcher's Mermaid — Butchery, Restaurant & Deli · Hout Bay</PageTitle>
<SeoMeta Title="The Butcher's Mermaid — Butchery, Restaurant & Deli · Hout Bay"
         Description="Premium butchery, upscale restaurant and deli in Hout Bay, Cape Town. Pasture-reared meats, house-made charcuterie, and seasonal seafood."
         Image="images/business/hero-interior.jpg" />

<StructuredData />


<CinematicLanding />


<section class="location-banner">
    <img src="images/business/hout-bay-banner.jpg" alt="Hout Bay, Cape Town" class="location-banner__bg" loading="lazy" />
    <div class="location-banner__overlay"></div>
    <div class="location-banner__content">
        <p class="eyebrow">Our Home</p>
        <h2 class="location-banner__title">Hout Bay, Cape Town</h2>
        <GoldDivider />
        <p class="location-banner__address">
            Shop 1, Red Sails Building · 26 Main Road · Hout Bay · 7806
        </p>
    </div>
</section>


<section class="find-us section section-card">
    <div class="container">
        <div class="find-us__header">
            <p class="eyebrow">Find Us</p>
            <h2 class="find-us__title">Come Visit</h2>
            <GoldDivider />
        </div>

        <div class="find-us__grid">
            <div class="find-us__col">
                <div class="find-us__block">
                    <h3 class="find-us__block-title">Address</h3>
                    <p>Shop 1, Red Sails Building</p>
                    <p>26 Main Road</p>
                    <p>Hout Bay, Cape Town, 7806</p>
                </div>

                <div class="find-us__block">
                    <h3 class="find-us__block-title">Get in Touch</h3>
                    <p><a href="mailto:@BusinessInfo.Email" class="find-us__link">@BusinessInfo.Email</a></p>
                    <p><a href="tel:@BusinessInfo.PhoneE164" class="find-us__link">@BusinessInfo.PhoneDisplay</a></p>
                </div>

                <div class="find-us__block">
                    <h3 class="find-us__block-title">Hours</h3>
                    <dl class="hours">
                        @foreach (var h in BusinessInfo.Hours)
                        {
                            <div class="hours__row @(h.Closed ? "hours__row--closed" : "")">
                                <dt class="hours__day">@h.Day</dt>
                                <dd class="hours__time">@h.Time</dd>
                            </div>
                        }
                    </dl>
                </div>

                <div class="find-us__block">
                    <h3 class="find-us__block-title">Follow</h3>
                    <div class="find-us__socials">
                        <a href="@BusinessInfo.FacebookUrl" target="_blank" rel="noopener noreferrer" class="find-us__social">Facebook</a>
                        <a href="@BusinessInfo.InstagramUrl" target="_blank" rel="noopener noreferrer" class="find-us__social">Instagram</a>
                    </div>
                </div>
            </div>

            <div class="find-us__col">
                <div class="find-us__map">
                    <iframe
                        src="https://www.google.com/maps?q=26+Main+Road,+Hout+Bay,+Cape+Town,+7806&output=embed"
                        width="100%"
                        height="100%"
                        style="border: 0;"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        title="The Butcher's Mermaid location">
                    </iframe>
                </div>
                <p class="find-us__map-caption">Red Sails Building, 26 Main Road, Hout Bay</p>

                <div class="find-us__cta">
                    <a href="@BusinessInfo.UberEatsUrl" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
                        Order on Uber Eats
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>