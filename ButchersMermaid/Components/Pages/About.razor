@page "/about"
@rendermode InteractiveServer

<PageTitle>About — The Butcher's Mermaid</PageTitle>
<SeoMeta Title="About — The Butcher's Mermaid"
         Description="The story of The Butcher's Mermaid — a butchery, restaurant, and deli in Hout Bay, Cape Town."
         Image="images/business/hero-interior.jpg" />

<PageHero BackgroundImage="images/business/hero-interior.jpg"
          Eyebrow="Our Story"
          Title="Coming Soon"
          Subtitle="The full story of The Butcher's Mermaid is being written." />

<section class="section">
    <div class="container container-narrow">
        <div class="section-header">
            <GoldDivider />
            <p class="section-header__subtitle" style="margin-top: var(--sp-6);">
                The full story of The Butcher's Mermaid — how we started, why we do what
                we do, and the people behind the counter — is being written.
            </p>
            <p class="section-header__subtitle" style="margin-top: var(--sp-6);">
                In the meantime, if you'd like to know more about us, get in touch directly:
            </p>
        </div>

        <div class="about-contact">
            <a href="mailto:info@thebutchersmermaid.co.za" class="about-contact__item">
                <span class="about-contact__label">Email</span>
                <span class="about-contact__value">info@thebutchersmermaid.co.za</span>
            </a>
            <a href="tel:+27213000282" class="about-contact__item">
                <span class="about-contact__label">Phone</span>
                <span class="about-contact__value">+27 21 300 0282</span>
            </a>
            <div class="about-contact__item about-contact__item--static">
                <span class="about-contact__label">Visit</span>
                <span class="about-contact__value">Shop 1, Red Sails Building<br />26 Main Road · Hout Bay</span>
            </div>
        </div>

        <p style="text-align: center; margin-top: var(--sp-12); color: var(--color-text-muted); font-weight: 300;">
            Open Tuesday through Saturday · 09:00–21:00
        </p>
    </div>
</section>