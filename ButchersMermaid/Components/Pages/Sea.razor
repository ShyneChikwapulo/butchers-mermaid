
@page "/sea"
@rendermode InteractiveServer

<PageTitle>From the Sea — The Butcher's Mermaid</PageTitle>

<PageHero BackgroundImage="images/business/sea-hero.jpg"
          Eyebrow="From the Sea"
          Title="Sustainable, Seasonal, Live"
          Subtitle="Yes — the mermaid is real. We source sustainable, seasonal seafood direct from local waters." />

<section class="section">
    <div class="container">
        <div class="split-section">
            <div class="split-section__media">
                <img src="images/business/sea-oysters.jpg" alt="Fresh oysters at The Butcher's Mermaid" loading="lazy" />
            </div>
            <div class="split-section__body">
                <p class="eyebrow">Shucked to Order</p>
                <h2>The Mermaid's Half of the Story</h2>
                <GoldDivider />
                <p>
                    Our seafood offering is small on purpose. Everything is sustainable,
                    seasonal, and market-dependent — we buy what's good, not what's
                    always available. Oysters are opened à la minute. Crayfish is only
                    listed when it's in season.
                </p>
                <p>
                    The result is a rotating selection that reflects the sea on the day
                    you visit. Ask your server what came in that morning.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="section section-card">
    <div class="container">
        <div class="section-header">
            <p class="eyebrow">What We Source</p>
            <h2 class="section-header__title">From Local Waters</h2>
            <GoldDivider />
        </div>

        <div class="photo-grid photo-grid--two">
            <img src="images/business/sea-crayfish.jpg" alt="West Coast crayfish at The Butcher's Mermaid" loading="lazy" />
            <img src="images/business/sea-oysters.jpg" alt="Live oysters at The Butcher's Mermaid" loading="lazy" />
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="split-section split-section--reverse">
            <div class="split-section__media">
                <img src="images/business/sea-crayfish.jpg" alt="Fresh seafood at The Butcher's Mermaid" loading="lazy" />
            </div>
            <div class="split-section__body">
                <p class="eyebrow">On the Menu</p>
                <h2>Oysters, Crayfish, Mussels</h2>
                <GoldDivider />
                <p>
                    Live oysters, opened to order and served on ice with lemon and
                    Tabasco. West Coast crayfish in season, grilled simply. Fresh
                    mussels in white wine, garlic, and cream.
                </p>
                <p>
                    The seafood selection on our menu changes with what the boats bring
                    in. Check the board, or ask what's fresh today.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="section section-card">
    <div class="container container-narrow">
        <div class="section-header">
            <p class="eyebrow">Come Try</p>
            <h2 class="section-header__title">Seafood, Served Simply</h2>
            <GoldDivider />
            <p class="section-header__subtitle">
                Book a table to see what's on today. Or order for delivery through
                Uber Eats.
            </p>
            <div style="margin-top: var(--sp-8); display: flex; gap: var(--sp-4); justify-content: center; flex-wrap: wrap;">
                <a href="https://www.dineplan.com/restaurant/the-butchers-mermaid"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-primary">Book a Table</a>
                <a href="https://www.ubereats.com/za/store/the-butchers-mermaid/WdjWPxY4RiyUx_Du-jwVdA"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-outline">Order on Uber Eats</a>
            </div>
        </div>
    </div>
</section>