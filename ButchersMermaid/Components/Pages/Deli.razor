
@page "/deli"
@rendermode InteractiveServer

<PageTitle>Deli &amp; Bar — The Butcher's Mermaid</PageTitle>

<PageHero BackgroundImage="images/business/deli-hero.jpg"
          Eyebrow="Deli &amp; Bar"
          Title="Take the Good Stuff Home"
          Subtitle="Artisan cheeses, cured meats, organic produce and boutique wines — with an off-consumption licence so you can take a bottle home." />

<section class="section">
    <div class="container">
        <div class="split-section">
            <div class="split-section__media">
                <img src="images/business/deli-cheese.jpg" alt="Artisan cheese at The Butcher's Mermaid deli" loading="lazy" />
            </div>
            <div class="split-section__body">
                <p class="eyebrow">The Deli Counter</p>
                <h2>A Curated Selection, Not a Supermarket</h2>
                <GoldDivider />
                <p>
                    We stock what we'd serve at our own table. Artisan cheeses from
                    local makers and select imports. Cured meats from our own curing
                    room and trusted suppliers. Organic vegetables from growers we know
                    by name.
                </p>
                <p>
                    Every item is chosen for a reason — provenance, quality, or simply
                    because it's exceptional. If it doesn't meet the bar, it doesn't
                    go on the shelf.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="section section-card">
    <div class="container">
        <div class="section-header">
            <p class="eyebrow">On Our Shelves</p>
            <h2 class="section-header__title">What You'll Find</h2>
            <GoldDivider />
        </div>

        <div class="photo-grid">
            <img src="images/business/deli-wine.jpg" alt="Boutique wine at The Butcher's Mermaid" loading="lazy" />
            <img src="images/business/deli-produce.jpg" alt="Fresh produce at The Butcher's Mermaid deli" loading="lazy" />
            <img src="images/business/deli-cheese.jpg" alt="Cheese selection at The Butcher's Mermaid" loading="lazy" />
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="split-section split-section--reverse">
            <div class="split-section__media">
                <img src="images/business/deli-wine.jpg" alt="Boutique wines at The Butcher's Mermaid" loading="lazy" />
            </div>
            <div class="split-section__body">
                <p class="eyebrow">The Bar &amp; Bottle Shop</p>
                <h2>Off-Consumption Licence</h2>
                <GoldDivider />
                <p>
                    Our boutique wine selection is available to drink in, or to take
                    home. Off-consumption sales let you walk out with a bottle you've
                    just enjoyed — something few restaurants can offer.
                </p>
                <p>
                    Craft cocktails at the bar. Sommelier-guided wine flights on request.
                    A rotating selection of small-batch spirits. This is the part of
                    the shop that keeps people coming back.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="section section-card">
    <div class="container container-narrow">
        <div class="section-header">
            <p class="eyebrow">Visit</p>
            <h2 class="section-header__title">Come Browse</h2>
            <GoldDivider />
            <p class="section-header__subtitle">
                The deli and butchery counter are open Tuesday through Saturday,
                09:00–21:00. Closed Sundays and Mondays.
            </p>
            <div style="margin-top: var(--sp-8);">
                <a href="/contact" class="btn btn-outline">Find Us</a>
            </div>
        </div>
    </div>
</section>